# MH System — example configuration. Copy to .env and fill in YOUR values.
# Do NOT commit a real .env (see .gitignore). Prefer n8n credentials for secrets.

# --- Claude AI ---
CLAUDE_ENDPOINT=https://api.anthropic.com/v1/messages
CLAUDE_PROXY_KEY=<CLAUDE_PROXY_KEY>
CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- Lark / Feishu ---
LARK_APP_ID=<LARK_APP_ID>
LARK_APP_SECRET=<LARK_APP_SECRET>
LARK_DOMAIN=https://open.larksuite.com
LARK_BASE_MHPOWER=<LARK_BASE_MHPOWER>
LARK_BASE_MHRENTAL=<LARK_BASE_MHRENTAL>
LARK_CHAT_SALES_POWER=<LARK_CHAT_SALES_POWER>
LARK_CHAT_SALES_RENTAL=<LARK_CHAT_SALES_RENTAL>
LARK_CHAT_HR=<LARK_CHAT_HR>
LARK_BOT_WEBHOOK_ID=<LARK_BOT_WEBHOOK_ID>

# --- Facebook / Meta ---
FB_PAGE_ID=<FB_PAGE_ID>
FB_APP_ID=<FB_APP_ID>
FB_APP_SECRET=<FB_APP_SECRET>
FB_ACCESS_TOKEN=<FB_ACCESS_TOKEN>
FB_VERIFY_TOKEN=<FB_VERIFY_TOKEN>
FB_GRAPH_VERSION=v21.0
META_AD_ACCOUNT_MAIN=<META_AD_ACCOUNT_MAIN>

# --- Google Ads (dashboard) ---
GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
GOOGLE_REFRESH_TOKEN=<GOOGLE_REFRESH_TOKEN>
GOOGLE_ADS_DEV_TOKEN=<GOOGLE_ADS_DEV_TOKEN>
GOOGLE_ADS_CUSTOMER_ID=<GOOGLE_ADS_CUSTOMER_ID>
GOOGLE_ADS_LOGIN_CUSTOMER_ID=<GOOGLE_ADS_LOGIN_CUSTOMER_ID>

# --- Webhooks / infra ---
PUBLIC_WEBHOOK_DOMAIN=<PUBLIC_WEBHOOK_DOMAIN>
MH04_WEBHOOK_KEY=<MH04_WEBHOOK_KEY>
N8N_DT_SESSIONS=<N8N_DT_SESSIONS>
N8N_DT_BUFFERS=<N8N_DT_BUFFERS>

# --- Cloudflare Tunnel (optional public webhook) ---
CF_API_TOKEN=<CF_API_TOKEN>
CF_ACCOUNT_TAG=<CF_ACCOUNT_TAG>
CF_ZONE_ID=<CF_ZONE_ID>
CF_TUNNEL_ID=<CF_TUNNEL_ID>
CF_TUNNEL_SECRET=<CF_TUNNEL_SECRET>

# --- Recruitment contact shown to applicants ---
RECRUIT_CONTACT_PHONE=<RECRUIT_CONTACT_PHONE>
RECRUIT_CONTACT_EMAIL=<RECRUIT_CONTACT_EMAIL>
